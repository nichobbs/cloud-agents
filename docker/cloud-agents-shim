#!/bin/bash
# Launcher for cloud-agents-shim (docs/phase6-mcp-callbacks.md), the
# in-container MCP callback server built from shim/ by docker/Dockerfile's
# own shim-builder stage and COPYed to /opt/cloud-agents-shim. Registered as
# the bare command "cloud-agents-shim" in docker/mcp-callbacks.json.template,
# which requires a real executable on PATH — `lyric build`'s "single"
# output is a directory of managed DLLs (Lyric.Stdlib.*, JsonRpc.dll,
# Mcp.dll, cloud-agents-shim.dll), not a standalone native binary, so this
# thin wrapper is what actually goes on PATH.
# Scoped here rather than as image-wide ENV in the harness Dockerfiles
# (#806): DOTNET_ROOT and invariant globalization are needs of THIS process
# only — leaking them into the agent's whole session environment would
# silently change the behavior of any .NET tooling the agent itself runs
# in-container. DOTNET_ROOT defaults rather than overrides so the claude
# image's SDK layout keeps working unchanged.
export DOTNET_ROOT="${DOTNET_ROOT:-/usr/share/dotnet}"
# Invariant globalization only where ICU is actually absent (#834 — the
# node:20-slim harness images): the claude image ships ICU with its SDK, and
# forcing invariant there would change this shim's runtime behavior from
# what it has always been. Respect an explicit caller override either way.
if [ -z "${DOTNET_SYSTEM_GLOBALIZATION_INVARIANT:-}" ] \
    && ! ldconfig -p 2>/dev/null | grep -q libicuuc; then
    export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
fi
exec dotnet /opt/cloud-agents-shim/cloud-agents-shim.dll "$@"
