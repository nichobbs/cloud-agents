# codex:base — Codex CLI runner image.
#
# Provides the OpenAI Codex CLI inside an ephemeral container.
# The API server sets HARNESS=codex, MODEL, NATIVE_SESSION_ID, PROMPT,
# REPO_URL, BRANCH, and OPENAI_API_KEY at runtime.
#
# Build:  docker build -t codex:base -f docker/Dockerfile.codex .   (repo-root context — needs docker/ AND shim/, #601)
# Arch:   multi-arch / portable

# ─── Stage 1: build cloud-agents-shim (docs/phase6-mcp-callbacks.md §5) ──────
#
# Duplicated (condensed) from docker/Dockerfile's shim-builder stage — that
# file is canonical and fully commented; keep the RUN instructions here
# byte-identical to it so Docker's layer cache builds the shim once and
# shares it across all five runner images. Requires the repo-root build
# context (it COPYs both docker/ and shim/), the same #601 change the
# claude image already made.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS shim-builder

ARG LYRIC_VERSION=""
COPY MIN_LYRIC_VERSION /tmp/min-lyric-version.txt

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/extra-ca-certs /tmp/extra-ca-certs
COPY docker/split-ca-bundle.sh docker/trust-extra-cas.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/split-ca-bundle.sh /usr/local/bin/trust-extra-cas.sh \
    && /usr/local/bin/trust-extra-cas.sh

COPY scripts/lyric-rid.sh scripts/verify-lyric-checksum.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/lyric-rid.sh /usr/local/bin/verify-lyric-checksum.sh \
    && LYRIC_RID="$(/usr/local/bin/lyric-rid.sh)" \
    && echo -n "$LYRIC_RID" > /tmp/lyric-rid.txt

RUN if [ -z "$LYRIC_VERSION" ]; then \
         for attempt in 1 2 3; do \
           LYRIC_VERSION="$(curl -sI --connect-timeout 10 --max-time 30 https://github.com/nichobbs/lyric-lang/releases/latest | sed -n 's/.*tag\/v\([0-9.]*\).*/\1/p' | tr -d '\r')"; \
           [ -n "$LYRIC_VERSION" ] && break; \
           echo "attempt $attempt: could not resolve latest Lyric release tag, retrying..." >&2; \
           sleep 3; \
         done; \
       fi \
    && if [ -z "$LYRIC_VERSION" ]; then echo "ERROR: could not resolve the latest Lyric version after 3 attempts" >&2; exit 1; fi \
    && MIN_VERSION="$(cat /tmp/min-lyric-version.txt)" \
    && LOWEST="$(printf '%s\n%s\n' "$MIN_VERSION" "$LYRIC_VERSION" | sort -V | head -1)" \
    && if [ "$LOWEST" != "$MIN_VERSION" ]; then echo "ERROR: Lyric version $LYRIC_VERSION is below the documented floor MIN_LYRIC_VERSION ($MIN_VERSION)" >&2; exit 1; fi \
    && echo "Installing Lyric compiler v${LYRIC_VERSION}" \
    && echo -n "${LYRIC_VERSION}" > /tmp/lyric-version.txt

RUN LYRIC_VERSION="$(cat /tmp/lyric-version.txt)" \
    && LYRIC_RID="$(cat /tmp/lyric-rid.txt)" \
    && LYRIC_ARCHIVE="lyric-${LYRIC_VERSION}-${LYRIC_RID}.tar.gz" \
    && curl -fsSL --connect-timeout 10 --max-time 120 --retry 3 --retry-delay 3 \
        -o /tmp/lyric.tgz \
        "https://github.com/nichobbs/lyric-lang/releases/download/v${LYRIC_VERSION}/${LYRIC_ARCHIVE}" \
    && /usr/local/bin/verify-lyric-checksum.sh "$LYRIC_VERSION" /tmp/lyric.tgz "$LYRIC_ARCHIVE" \
    && mkdir -p /usr/local/bin \
    && tar -xzf /tmp/lyric.tgz -C /usr/local/bin \
    && rm -f /tmp/lyric.tgz
WORKDIR /src/shim
COPY shim/ ./
RUN lyric restore && lyric build

# ─── Stage 2: the runner image itself ────────────────────────────────────────
FROM node:22-slim

ENV DEBIAN_FRONTEND=noninteractive

# Pinned to a version confirmed to install cleanly (bump deliberately, not
# by dropping the pin back to @latest — an untested "latest" is what took
# the whole Coolify deploy down the first time this ran unpinned, see
# deploy/COOLIFY.md). The retry loop guards against transient npm-registry
# failures, the other documented cause of a mid-build failure here.
# gettext-base provides envsubst, used by docker/inject-library.sh to expand
# ${VAR} references in a seeded/user-authored MCP server's env values against
# this container's own credential env vars (#mcp-server-seeding). python3
# and python3-pip are here for session scripts (matches docker/Dockerfile's
# base image, which already carries both) — this leaner node:22-slim-based
# image had been missing them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git bash curl ca-certificates jq gettext-base python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Optional corporate/proxy root CA trust (e.g. Zscaler TLS inspection) — see
# extra-ca-certs/README.md. A no-op when that directory holds only its
# placeholder README. Must run before the npm install below. Trusts the
# cert(s) both at the OS level (update-ca-certificates, for curl/git) AND
# via NODE_EXTRA_CA_CERTS — Node ships its own bundled CA store and does
# NOT consult the OS trust store, so update-ca-certificates alone is not
# enough to get npm past a corporate proxy's re-signed certs (confirmed:
# npm still failed SELF_SIGNED_CERT_IN_CHAIN after update-ca-certificates
# alone reported the cert added). The combined pem is always created (even
# empty) so NODE_EXTRA_CA_CERTS can be set unconditionally — Node treats a
# missing or empty file as a harmless no-op (a warning at worst), so this
# is safe with nothing dropped into extra-ca-certs/. trust-extra-cas.sh
# (#686) is the shared script behind this — see docker/Dockerfile's own
# copy of this comment for the full rationale.
COPY docker/extra-ca-certs /tmp/extra-ca-certs
COPY docker/split-ca-bundle.sh docker/trust-extra-cas.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/split-ca-bundle.sh /usr/local/bin/trust-extra-cas.sh \
    && /usr/local/bin/trust-extra-cas.sh
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/extra-combined.pem

# uv/uvx: a standalone Rust binary (no Python runtime dependency of its own),
# installed system-wide so it's on PATH regardless of which user runs a
# session. Needed to launch the official `mcp-server-fetch` MCP server (the
# seeded "fetch" default, seed/mcp-servers/fetch.json) via `uvx
# mcp-server-fetch` — deliberately the official reference implementation
# (github.com/modelcontextprotocol/servers) rather than a smaller
# single-maintainer npm alternative, since this ships to every user by
# default. Installed after the CA-trust step above so the download works
# behind a TLS-intercepting proxy. Pinned to a version confirmed to install
# cleanly (bump deliberately, not by dropping the pin — astral.sh/uv/install.sh
# with no version in the path always serves whatever uv shipped most
# recently, an untested "latest" that could break a build without warning).
RUN curl -LsSf --connect-timeout 10 --max-time 120 --retry 3 --retry-delay 3 https://astral.sh/uv/0.12.0/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# GitHub CLI (gh): lets an agent session interact with GitHub (PRs, issues,
# checks) via `gh`/`gh api` without needing a GitHub MCP server or hand-
# rolled curl+jq calls. Installed from the official apt repository
# (cli.github.com/packages) rather than a pinned github.com release
# tarball, matching this image's own use of plain APT for other mature,
# stable CLIs (git, jq) — and unlike a github.com release download, this
# repo is reachable even when a build environment's proxy restricts direct
# github.com access. Installed after the CA-trust step above so the
# keyring/package fetch works behind a TLS-intercepting proxy too. Version
# pinned like every other agent-facing CLI in this file (bump deliberately,
# not by dropping the pin). RUN text kept byte-identical across
# Dockerfile.codex/.opencode/.gemini so their layer caches share, matching
# the shim-builder stage's existing convention.
ARG GH_CLI_VERSION="2.100.0"
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL --connect-timeout 10 --max-time 30 --retry 3 --retry-delay 3 \
        https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "gh=${GH_CLI_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN n=0; until npm install -g @openai/codex@0.145.0; do \
      n=$((n + 1)); \
      if [ "$n" -ge 3 ]; then echo "npm install -g @openai/codex failed after 3 attempts" >&2; exit 1; fi; \
      echo "npm install -g @openai/codex failed (attempt $n/3), retrying in 5s..." >&2; \
      sleep 5; \
    done

RUN useradd --create-home --home-dir /home/codex-user --shell /bin/bash codex-user
WORKDIR /workspace
RUN chown codex-user:codex-user /workspace

COPY docker/entrypoint-codex.sh /usr/local/bin/entrypoint.sh
COPY docker/reconcile-repos.sh /usr/local/bin/reconcile-repos.sh
COPY docker/create-fallback-branch.sh /usr/local/bin/create-fallback-branch.sh
COPY docker/inject-library.sh /usr/local/bin/inject-library.sh
COPY docker/render-branch-policy.sh /usr/local/bin/render-branch-policy.sh
COPY docker/branch-policy-rules.md /etc/cloud-agents/branch-policy-rules.md
COPY docker/session-tools-guide.md /etc/cloud-agents/session-tools-guide.md
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/reconcile-repos.sh /usr/local/bin/create-fallback-branch.sh /usr/local/bin/inject-library.sh /usr/local/bin/render-branch-policy.sh

# ─── cloud-agents-shim (docs/phase6-mcp-callbacks.md) ───────────────────────
# The in-container MCP callback server, giving this harness the same
# add_todo/update_todo/report_progress/... tools the claude image has had
# since Phase 6. Managed DLLs come from the shim-builder stage; the .NET
# runtime to execute them is copied from the official runtime image
# (bookworm has no dotnet apt packages). Invariant globalization avoids an
# ICU dependency node:22-slim doesn't ship — the shim only does ordinal
# string work. Registration into this harness's native MCP config happens
# per message in the entrypoint via register-callbacks-mcp.sh.
COPY --from=shim-builder /src/shim/bin/. /opt/cloud-agents-shim/
COPY --from=mcr.microsoft.com/dotnet/runtime:10.0 /usr/share/dotnet /usr/share/dotnet
COPY docker/cloud-agents-shim /usr/local/bin/cloud-agents-shim
COPY docker/register-callbacks-mcp.sh /usr/local/bin/register-callbacks-mcp.sh
# No image-wide DOTNET_* ENV here (#806): the wrapper script exports
# DOTNET_ROOT / DOTNET_SYSTEM_GLOBALIZATION_INVARIANT for the shim process
# alone, so the agent's own session environment is untouched.
RUN ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
    && chmod +x /usr/local/bin/cloud-agents-shim /usr/local/bin/register-callbacks-mcp.sh \
    && shim_out=$(cloud-agents-shim 2>&1 || true) \
    && case "$shim_out" in \
         *CLOUD_AGENTS_API_URL*) echo "shim smoke test ok" ;; \
         *) echo "shim smoke test FAILED — expected the missing-env panic, got: $shim_out" >&2; exit 1 ;; \
       esac

USER codex-user
ENV HOME=/home/codex-user

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
