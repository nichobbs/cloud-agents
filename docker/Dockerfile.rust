# claude-code:rust — Phase 4 tool pack.
#
# Extends the base runner with the Rust toolchain (cargo, rustc).
# Build:  docker build -t claude-code:rust -f docker/Dockerfile.rust docker
#
# Requires claude-code:base to be built first.

FROM claude-code:base

# Root for the install below; the base image already ends as root, see the
# note at the bottom of this file for why this must not be reverted at the end.
USER root
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal \
    && chmod -R a+rwX /usr/local/cargo \
    && rustc --version

# Deliberately NO trailing `USER claude-user` (#1048): docker/Dockerfile ends
# as root so docker/entrypoint.sh can run its root-only prelude (host CA
# trust, home-volume ownership heal, vault credential restore, git
# safe.directory) before dropping to claude-user itself (#652). A tool pack
# that ended as claude-user would start non-root and silently skip that
# prelude, so it must inherit the base image's root start.
